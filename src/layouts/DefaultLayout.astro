---
import '../styles/custom.css';
import Navigation from '../components/Navigation.astro';
import PageContent from '../components/PageContent.astro';
import RuntimeScripts from '../components/RuntimeScripts.astro';
import SearchBar from '../components/SearchBar.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ThemePreloadScript from '../components/ThemePreloadScript.astro';
import type { NavigationItem, ResolvedConfig } from '../types/config';
import type { PageEntry } from '../types/page';
import type { RenderContext } from '../types/render';

interface Props {
  config: ResolvedConfig;
  pages?: PageEntry[];
  navigationData?: NavigationItem[];
  renderContext?: RenderContext;
  fontLinks?: string;
  fontCss?: string;
  currentYear?: number;
  runtimeConfigJson?: string;
  version?: string;
}

const {
  config,
  pages = [],
  navigationData = [],
  renderContext,
  fontLinks = '',
  fontCss = '',
  currentYear,
  runtimeConfigJson = '{}',
  version = '',
} = Astro.props;

const site = config.site || {};
const themeMode = site.theme?.mode || 'dark';
const favicon = site.favicon || 'menav.svg';
const fontAwesomeCssUrl =
  'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css';
const fontAwesomePreload = `<link rel="preload" href="${fontAwesomeCssUrl}" as="style" onload="this.onload=null;this.rel='stylesheet'" />`;
---

<!doctype html>
<html lang="zh-CN" data-theme-mode={themeMode} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
    <meta name="menav-version" content={version} />
    <title data-editable="site-title">{site.title}</title>
    <meta name="description" content={site.description} data-editable="site-description" />
    <meta name="author" content={site.author} data-editable="site-author" />
    <link rel="icon" href={`./${favicon}`} type="image/x-icon" />
    <link rel="shortcut icon" href={`./${favicon}`} type="image/x-icon" />
    <Fragment set:html={fontLinks} />
    <style set:html={fontCss}></style>
    <ThemePreloadScript />
    <link rel="stylesheet" href="./assets/style.css" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <Fragment set:html={fontAwesomePreload} />
    <noscript>
      <link rel="stylesheet" href={fontAwesomeCssUrl} />
    </noscript>
    <!-- 终极自定义样式：最高强权版 -->
    <style is:global>
      /* 1. 彻底清空所有底色 */
      html, body, .layout, .content, .page, .page-template-home, .dashboard-grid {
        background-color: transparent !important;
      }

      /* 2. 魔法垫片：这个伪元素会盖在系统的黑底之上，但在你的文字之下 */
      body::before {
        content: "";
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        z-index: 0; /* 放在 0 层，刚好压住底部的黑色，又不会挡住内容 */
        pointer-events: none; /* 让你能正常点击网页 */
        background-size: cover !important;
        background-attachment: fixed !important;
        background-position: center !important;
      }

      /* 白天模式垫片 */
      html.light-theme body::before {
        background-image: linear-gradient(rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0.4)), url('https://shirasu224.github.io/menav/pics/pyrohous.jpg') !important;
      }

      /* 黑夜模式垫片 */
      html[data-theme-mode="dark"]:not(.light-theme) body::before {
        background-image: linear-gradient(rgba(15, 15, 20, 0.6), rgba(15, 15, 20, 0.6)), url('https://shirasu224.github.io/menav/pics/nightsnipe.jpg') !important;
      }

      /* 3. 把你的所有内容提上来，压在垫片上面 */
      .layout {
        position: relative !important;
        z-index: 1 !important; 
      }

      /* 4. 时钟卡片渐变 (透明度 0.4) */
      html[data-theme-mode="dark"]:not(.light-theme) .dashboard-clock-card {
        background: linear-gradient(180deg, rgba(70, 83, 124, 0.2) 0%, rgba(141, 124, 129, 0.2) 100%) !important;
        backdrop-filter: blur(10px) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 16px !important;
      }
      html[data-theme-mode="dark"]:not(.light-theme) .dashboard-clock-card * { color: #ffffff !important; }
      
      html.light-theme .dashboard-clock-card {
        background: linear-gradient(180deg, rgba(204, 237, 255, 0.2) 0%, rgba(255, 229, 229, 0.2) 100%) !important;
        backdrop-filter: blur(10px) !important;
        border: 1px solid rgba(255, 255, 255, 0.6) !important;
        border-radius: 16px !important;
      }
      html.light-theme .dashboard-clock-card * { color: #222222 !important; }

      /* 5. 侧边栏背景 */
      html.light-theme .sidebar {
        background: linear-gradient(rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0.6)), url('https://shirasu224.github.io/menav/pics/pyrohous.jpg') !important;
        background-size: cover !important;
        background-attachment: fixed !important;
      }
      html[data-theme-mode="dark"]:not(.light-theme) .sidebar {
        background: linear-gradient(rgba(15, 15, 20, 0.7), rgba(15, 15, 20, 0.7)), url('https://shirasu224.github.io/menav/pics/nightsnipe.jpg') !important;
        background-size: cover !important;
        background-attachment: fixed !important;
      }

      /* 6. 电脑端：锁死螃蟹尺寸 */
      .dashboard-grid {
        display: grid !important;
        grid-template-columns: 1fr 1fr !important; 
        align-items: center !important; 
        gap: 20px !important;
      }
      .dashboard-stats > * { display: none !important; }
      .dashboard-stats {
        width: 320px !important; 
        height: 260px !important; 
        margin: 0 auto !important;
        background-image: url('https://shirasu224.github.io/menav/pics/the-spycrab2.png') !important;
        background-size: contain !important; 
        background-repeat: no-repeat !important;
        background-position: center !important;
        background-color: transparent !important;
        border: none !important;
      }

      /* 7. 手机端专属排版 */
      @media (max-width: 768px) {
        .dashboard-grid {
          position: relative !important; 
          display: flex !important;
          flex-direction: column !important;
          align-items: flex-start !important; 
          width: 100% !important;
          padding-left: 15px !important; 
          padding-right: 15px !important;
          box-sizing: border-box !important; 
          gap: 10px !important;
        }
        .dashboard-intro {
          width: 100% !important;
          display: flex !important;
          flex-direction: column !important;
          align-items: flex-start !important;
          text-align: left !important;
        }
        .dashboard-welcome {
          width: 100% !important;
          margin: 0 !important;
          padding: 0 !important; 
          text-align: left !important; 
        }
        .dashboard-welcome h1 {
          font-size: 1.3rem !important;
          margin: 0 0 -2px 0 !important; 
          line-height: 1.2 !important;
        }
        .dashboard-welcome p {
          font-size: 0.85rem !important;
          margin: 0 !important;
          line-height: 1.2 !important;
        }
        
        .dashboard-stats {
          display: block !important;
          position: absolute !important;
          top: 5px !important;      
          right: 15px !important;   
          width: 100px !important;   
          height: 100px !important;  
          background-position: top right !important; 
          margin: 0 !important;
          z-index: 10 !important;
        }
        
        .dashboard-clock-card {
          display: flex !important;
          flex-direction: column !important;
          width: 75% !important;        
          max-width: 260px !important;  
          height: auto !important; 
          padding: 12px 15px !important; 
          margin: 0 !important;         
          margin-top: 5px !important; 
          position: relative !important;
        }
        
        .dashboard-clock-card .clock-main {
          font-size: 1.8rem !important; 
          text-align: right !important;
          line-height: 1.1 !important;
        }
        .dashboard-clock-card .clock-header,
        .dashboard-clock-card .clock-date {
          font-size: 0.8rem !important;
          white-space: nowrap !important; 
        }
      }
    </style>
  </head>
  <body class="loading">
    <div class="layout">
      <div class="mobile-buttons">
        <button class="menu-toggle" aria-label="切换菜单">
          <i class="fas fa-bars"></i>
        </button>
        <button class="search-toggle" aria-label="切换搜索">
          <i class="fas fa-search"></i>
        </button>
      </div>

      <div class="overlay"></div>

      <nav class="sidebar">
        <div class="logo">
          <div class="logo-brand">
            {
              site.favicon && (
                <img
                  class="logo-image"
                  src={`./${site.favicon}`}
                  alt={`${site.title} logo`}
                  width="26"
                  height="26"
                />
              )
            }
            <h1 data-editable="logo-text">{site.logo_text}</h1>
          </div>
          <button class="sidebar-toggle" aria-label="收起/展开侧边栏">
            <i class="fas fa-chevron-left toggle-icon"></i>
          </button>
        </div>

        <div class="sidebar-content">
          <div class="nav-section">
            <Navigation navigation={navigationData} />
          </div>
          <div class="sidebar-submenu-panel" aria-label="页面分类" data-container="sidebar-submenu">
          </div>
        </div>

        <div class="sidebar-social" data-container="social-links">
          <SocialLinks
            social={config.social || []}
            allowedSchemes={renderContext?.allowedSchemes}
          />
        </div>

        <div class="sidebar-footer">
          <div class="copyright">
            <p>
              © {currentYear}
              <a href="https://github.com/rbetree/menav" target="_blank" rel="noopener">MeNav</a>
            </p>
            <p>
              by <a href="https://github.com/rbetree" target="_blank" rel="noopener">rbetree</a>
            </p>
          </div>
        </div>
      </nav>

      <main class="content">
        <SearchBar />

        {
          pages.map((entry) => (
            <div class:list={['page', entry.id, entry.isActive && 'active']} id={entry.id}>
              <PageContent
                page={entry.data}
                templateName={entry.templateName}
                renderContext={renderContext}
              />
            </div>
          ))
        }
      </main>

      <button class="category-toggle" id="category-toggle" aria-label="展开/收起分类">
        <i class="fas fa-angle-double-down"></i>
      </button>

      <button class="theme-toggle" aria-label="切换主题">
        <i class="fas fa-moon"></i>
      </button>
    </div>

    <RuntimeScripts runtimeConfigJson={runtimeConfigJson} />
  </body>
</html>
