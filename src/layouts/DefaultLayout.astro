---
import '../styles/custom.css';
import Navigation from '../components/Navigation.astro';
import PageContent from '../components/PageContent.astro';
import RuntimeScripts from '../components/RuntimeScripts.astro';
import SearchBar from '../components/SearchBar.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ThemePreloadScript from '../components/ThemePreloadScript.astro';
import type { NavigationItem, ResolvedConfig } from '../types/config';
import type { PageEntry } from '../types/page';
import type { RenderContext } from '../types/render';

interface Props {
  config: ResolvedConfig;
  pages?: PageEntry[];
  navigationData?: NavigationItem[];
  renderContext?: RenderContext;
  fontLinks?: string;
  fontCss?: string;
  currentYear?: number;
  runtimeConfigJson?: string;
  version?: string;
}

const {
  config,
  pages = [],
  navigationData = [],
  renderContext,
  fontLinks = '',
  fontCss = '',
  currentYear,
  runtimeConfigJson = '{}',
  version = '',
} = Astro.props;

const site = config.site || {};
const themeMode = site.theme?.mode || 'dark';
const favicon = site.favicon || 'menav.svg';
const fontAwesomeCssUrl =
  'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css';
const fontAwesomePreload = `<link rel="preload" href="${fontAwesomeCssUrl}" as="style" onload="this.onload=null;this.rel='stylesheet'" />`;
---

<!doctype html>
<html lang="zh-CN" data-theme-mode={themeMode} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
    <meta name="menav-version" content={version} />
    <title data-editable="site-title">{site.title}</title>
    <meta name="description" content={site.description} data-editable="site-description" />
    <meta name="author" content={site.author} data-editable="site-author" />
    <link rel="icon" href={`./${favicon}`} type="image/x-icon" />
    <link rel="shortcut icon" href={`./${favicon}`} type="image/x-icon" />
    <Fragment set:html={fontLinks} />
    <style set:html={fontCss}></style>
    <ThemePreloadScript />
    <link rel="stylesheet" href="./assets/style.css" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <Fragment set:html={fontAwesomePreload} />
    <noscript>
      <link rel="stylesheet" href={fontAwesomeCssUrl} />
    </noscript>
  </head>
  <body class="loading">
    <div class="layout">
      <div class="mobile-buttons">
        <button class="menu-toggle" aria-label="切换菜单">
          <i class="fas fa-bars"></i>
        </button>
        <button class="search-toggle" aria-label="切换搜索">
          <i class="fas fa-search"></i>
        </button>
      </div>

      <div class="overlay"></div>

      <nav class="sidebar">
        <div class="logo">
          <div class="logo-brand">
            {
              site.favicon && (
                <img
                  class="logo-image"
                  src={`./${site.favicon}`}
                  alt={`${site.title} logo`}
                  width="26"
                  height="26"
                />
              )
            }
            <h1 data-editable="logo-text">{site.logo_text}</h1>
          </div>
          <button class="sidebar-toggle" aria-label="收起/展开侧边栏">
            <i class="fas fa-chevron-left toggle-icon"></i>
          </button>
        </div>

        <div class="sidebar-content">
          <div class="nav-section">
            <Navigation navigation={navigationData} />
          </div>
          <div class="sidebar-submenu-panel" aria-label="页面分类" data-container="sidebar-submenu">
          </div>
        </div>

        <div class="sidebar-social" data-container="social-links">
          <SocialLinks
            social={config.social || []}
            allowedSchemes={renderContext?.allowedSchemes}
          />
        </div>

        <div class="sidebar-footer">
          <div class="copyright">
            <p>
              © {currentYear}
              <a href="https://github.com/rbetree/menav" target="_blank" rel="noopener">MeNav</a>
            </p>
            <p>
              by <a href="https://github.com/rbetree" target="_blank" rel="noopener">rbetree</a>
            </p>
          </div>
        </div>
      </nav>

      <main class="content">
        <SearchBar />

        {
          pages.map((entry) => (
            <div class:list={['page', entry.id, entry.isActive && 'active']} id={entry.id}>
              <PageContent
                page={entry.data}
                templateName={entry.templateName}
                renderContext={renderContext}
              />
            </div>
          ))
        }
      </main>

      <button class="category-toggle" id="category-toggle" aria-label="展开/收起分类">
        <i class="fas fa-angle-double-down"></i>
      </button>

      <button class="theme-toggle" aria-label="切换主题">
        <i class="fas fa-moon"></i>
      </button>
    </div>

      <RuntimeScripts runtimeConfigJson={runtimeConfigJson} />

      <!-- 终极自定义样式 -->
        /* ================= 全局背景图替换 ================= */
        /* 1. 先把系统原本的纯黑/纯白底色变成透明 */
        html, body, .layout {
          background-color: transparent !important;
        }

        /* 2. 创建一个底层垫片放背景图 */
        body::before {
          content: "";
          position: fixed;
          inset: 0;
          z-index: -999; /* 放在所有东西的最底层 */
          pointer-events: none; /* 不影响鼠标点击 */
          background-size: cover; /* 自动铺满全屏，保持比例裁剪 */
          background-position: center; /* 居中显示 */
          background-repeat: no-repeat; /* 不重复平铺 */
        }

        /* 3. 白天模式背景图 */
        html.light-theme body::before {
          /* 把这里的网址换成你的白天图片链接 */
          background-image: url('https://shirasu224.github.io/menav/pics/glitter_blu.jpg'); 
          opacity: 0.4; /* 👈 透明度：0 是全透，1 是不透。0.4 代表 40% 不透明度，你可以调成 0.2 或 0.8 */
        }

        /* 4. 黑夜模式背景图 */
        html[data-theme-mode="dark"]:not(.light-theme) body::before {
          /* 把这里的网址换成你的黑夜图片链接 */
          background-image: url('https://shirasu224.github.io/menav/pics/mood_tree.jpg'); 
          opacity: 0.3; /* 黑夜模式通常需要更暗一点，不然刺眼，你可以自己调 */
        }
      <style is:global>
        /* 1. 白天模式：深#ccedff -> 浅#ffe5e5 */
        html.light-theme .dashboard-clock-card {
          /* 60% 透明度，0.6 可以自己调，越小越透 */
          background: linear-gradient(180deg, rgba(204, 237, 255, 0.4) 0%, rgba(255, 229, 229, 0.4) 100%) !important;
          background-image: linear-gradient(180deg, rgba(204, 237, 255, 0.4) 0%, rgba(255, 229, 229, 0.4) 100%) !important;
          backdrop-filter: blur(12px) !important; /* 磨砂玻璃效果 */
          -webkit-backdrop-filter: blur(12px) !important;
          border: 1px solid rgba(255, 255, 255, 0.6) !important;
          border-radius: 16px !important;
          box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05) !important;
          overflow: hidden !important;
        }
        html.light-theme .dashboard-clock-card * {
          color: #222222 !important;
        }

        /* 2. 黑夜模式：深#46537c -> 浅#8d7c81 */
        html[data-theme-mode="dark"]:not(.light-theme) .dashboard-clock-card {
          background: linear-gradient(180deg, rgba(70, 83, 124, 0.4) 0%, rgba(141, 124, 129, 0.4) 100%) !important;
          background-image: linear-gradient(180deg, rgba(70, 83, 124, 0.4) 0%, rgba(141, 124, 129, 0.4) 100%) !important;
          backdrop-filter: blur(12px) !important; 
          -webkit-backdrop-filter: blur(12px) !important;
          border: 1px solid rgba(255, 255, 255, 0.1) !important;
          border-radius: 16px !important;
          box-shadow: none !important; 
          outline: none !important; 
          overflow: hidden !important;
        }
        html[data-theme-mode="dark"]:not(.light-theme) .dashboard-clock-card * {
          color: #ffffff !important;
        }

        /* 强制隐藏黑夜多余发光层 */
        html[data-theme-mode="dark"]:not(.light-theme) .dashboard-clock-card::before,
        html[data-theme-mode="dark"]:not(.light-theme) .dashboard-clock-card::after {
          display: none !important;
          opacity: 0 !important;
          background: transparent !important;
        }

        /* 3. 终极封印：彻底干掉所有悬停时的阴影、边框和背景色变化 */
        .dashboard-grid:hover,
        .dashboard-grid > div:hover,
        .dashboard-panel:hover,
        .dashboard-panel > div:hover,
        .dashboard-clock-card:hover,
        .card:hover, 
        .category-card:hover, 
        .page-home .category:hover {
          box-shadow: none !important; 
          border-color: transparent !important; 
          outline: none !important; 
          background-color: transparent !important; 
        }
      </style>
    </body>
</html>
