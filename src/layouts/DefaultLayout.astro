---
import '../styles/custom.css';
import Navigation from '../components/Navigation.astro';
import PageContent from '../components/PageContent.astro';
import RuntimeScripts from '../components/RuntimeScripts.astro';
import SearchBar from '../components/SearchBar.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ThemePreloadScript from '../components/ThemePreloadScript.astro';
import type { NavigationItem, ResolvedConfig } from '../types/config';
import type { PageEntry } from '../types/page';
import type { RenderContext } from '../types/render';

interface Props {
  config: ResolvedConfig;
  pages?: PageEntry[];
  navigationData?: NavigationItem[];
  renderContext?: RenderContext;
  fontLinks?: string;
  fontCss?: string;
  currentYear?: number;
  runtimeConfigJson?: string;
  version?: string;
}

const {
  config,
  pages = [],
  navigationData = [],
  renderContext,
  fontLinks = '',
  fontCss = '',
  currentYear,
  runtimeConfigJson = '{}',
  version = '',
} = Astro.props;

const site = config.site || {};
const themeMode = site.theme?.mode || 'dark';
const favicon = site.favicon || 'menav.svg';
const fontAwesomeCssUrl =
  'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css';
const fontAwesomePreload = `<link rel="preload" href="${fontAwesomeCssUrl}" as="style" onload="this.onload=null;this.rel='stylesheet'" />`;
---

<!doctype html>
<html lang="zh-CN" data-theme-mode={themeMode} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
    <meta name="menav-version" content={version} />
    <title data-editable="site-title">{site.title}</title>
    <meta name="description" content={site.description} data-editable="site-description" />
    <meta name="author" content={site.author} data-editable="site-author" />
    <link rel="icon" href={`./${favicon}`} type="image/x-icon" />
    <link rel="shortcut icon" href={`./${favicon}`} type="image/x-icon" />
    <Fragment set:html={fontLinks} />
    <style set:html={fontCss}></style>
    <ThemePreloadScript />
    <link rel="stylesheet" href="./assets/style.css" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <Fragment set:html={fontAwesomePreload} />
    <noscript>
      <link rel="stylesheet" href={fontAwesomeCssUrl} />
    </noscript>
    
    <!-- 只保留最底层背景，其他全交给 style.css -->
    <style is:global>
      html, body, .layout, .content, .page, .page-template-home, .dashboard-grid {
        background-color: transparent !important;
      }

      body::before {
        content: "";
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        z-index: 0;
        pointer-events: none;
        background-size: cover !important;
        background-attachment: fixed !important;
        background-position: center !important;
      }

      html.light-theme body::before {
        background-image: linear-gradient(rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0.4)), url('https://shirasu224.github.io/menav/pics/pyrohous.jpg') !important;
      }
      html[data-theme-mode="dark"]:not(.light-theme) body::before {
        background-image: linear-gradient(rgba(15, 15, 20, 0.6), rgba(15, 15, 20, 0.6)), url('https://shirasu224.github.io/menav/pics/nightsnipe.jpg') !important;
      }

      .layout {
        position: relative !important;
        z-index: 1 !important; 
      }

      /* 只隐藏不需要的文字，尺寸全交给 style.css */
      .dashboard-stats > * { display: none !important; }
    </style>
  </head>
  <body class="loading">
    <div class="layout">
      <div class="mobile-buttons">
        <button class="menu-toggle" aria-label="切换菜单">
          <i class="fas fa-bars"></i>
        </button>
        <button class="search-toggle" aria-label="切换搜索">
          <i class="fas fa-search"></i>
        </button>
      </div>

      <div class="overlay"></div>

      <nav class="sidebar">
        <div class="logo">
          <div class="logo-brand">
            {
              site.favicon && (
                <img
                  class="logo-image"
                  src={`./${site.favicon}`}
                  alt={`${site.title} logo`}
                  width="26"
                  height="26"
                />
              )
            }
            <h1 data-editable="logo-text">{site.logo_text}</h1>
          </div>
          <button class="sidebar-toggle" aria-label="收起/展开侧边栏">
            <i class="fas fa-chevron-left toggle-icon"></i>
          </button>
        </div>

        <div class="sidebar-content">
          <div class="nav-section">
            <Navigation navigation={navigationData} />
          </div>
          <div class="sidebar-submenu-panel" aria-label="页面分类" data-container="sidebar-submenu">
          </div>
        </div>

        <div class="sidebar-social" data-container="social-links">
          <SocialLinks
            social={config.social || []}
            renderContext={renderContext}
          />
        </div>

        <div class="sidebar-footer">
          <div class="copyright">
            <p>
              © {currentYear}
              <a href="https://github.com/rbetree/menav" target="_blank" rel="noopener">MeNav</a>
            </p>
            <p>
              by <a href="https://github.com/rbetree" target="_blank" rel="noopener">rbetree</a>
            </p>
          </div>
        </div>
      </nav>

      <main class="content">
        <SearchBar />

        {
          pages.map((entry) => (
            <div class:list={['page', entry.id, entry.isActive && 'active']} id={entry.id}>
              <PageContent
                page={entry.data}
                templateName={entry.templateName}
                renderContext={renderContext}
              />
            </div>
          ))
        }
      </main>

      <button class="category-toggle" id="category-toggle" aria-label="展开/收起分类">
        <i class="fas fa-angle-double-down"></i>
      </button>

      <button class="theme-toggle" aria-label="切换主题">
        <i class="fas fa-moon"></i>
      </button>
    </div>

    <RuntimeScripts runtimeConfigJson={runtimeConfigJson} />
<!-- 音乐播放器组 -->
<audio id="bgm" loop>
  <source src="./music/bgm.mp3" type="audio/mpeg" />
</audio>

<div class="music-player-group">
  <button id="prev-btn" class="music-sub-btn" aria-label="上一首">
    <i class="fas fa-backward-step"></i>
  </button>
  <button id="music-btn" class="music-btn" aria-label="播放/暂停音乐">
    <i class="fas fa-play"></i>
  </button>
  <button id="next-btn" class="music-sub-btn" aria-label="下一首">
    <i class="fas fa-forward-step"></i>
  </button>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const playlist = [
      './music/Upgrade_Station.mp3',
      './music/Petite_Chou_Fleur.mp3',
    ];
    
    let currentIndex = 0;
    const bgm = document.getElementById('bgm');
    const btn = document.getElementById('music-btn');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const icon = btn.querySelector('i');

    if (playlist.length > 0) {
      bgm.src = playlist[currentIndex];
    }

    // 💥 核心：强制更新 UI 状态的函数
    function updateUI(isPlaying) {
      if (isPlaying) {
        btn.classList.add('playing');
        icon.className = 'fas fa-music';
      } else {
        btn.classList.remove('playing');
        icon.className = 'fas fa-play';
      }
    }

    // 监听音频真实状态（作为兜底）
    bgm.addEventListener('play', () => updateUI(true));
    bgm.addEventListener('pause', () => updateUI(false));

    // 点击播放/暂停
    btn.addEventListener('click', () => {
      if (bgm.paused) {
        // 点击瞬间直接强制 UI 变转，不等浏览器触发事件
        updateUI(true); 
        bgm.play().catch(e => {
          console.log("播放失败:", e);
          updateUI(false); // 如果报错了，UI 恢复原状
        });
      } else {
        bgm.pause();
        updateUI(false);
      }
    });

    // 切歌函数
    function playSong(index) {
      currentIndex = index;
      bgm.pause(); 
      bgm.src = playlist[currentIndex];
      bgm.load(); // 强制重新加载资源
      updateUI(true); // 切歌直接让按钮转起来
      bgm.play().catch(e => {
        console.log("播放失败:", e);
        updateUI(false);
      });
    }

    prevBtn.addEventListener('click', () => {
      let index = currentIndex - 1;
      if (index < 0) index = playlist.length - 1;
      playSong(index);
    });

    nextBtn.addEventListener('click', () => {
      let index = currentIndex + 1;
      if (index >= playlist.length) index = 0;
      playSong(index);
    });
  });
</script>
  </body>
</html>
